{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.oxygenframe/oxframe",
  "title": "oxframe",
  "description": "Make videos from code: check scenes frame by frame, inspect nodes, render a frame, search the docs.",
  "repository": {
    "url": "https://github.com/oxygenframe/oxframe-cli",
    "source": "github"
  },
  "websiteUrl": "https://oxframe.dev/docs/agents",
  "version": "0.20.2",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "oxframe-cli",
      "version": "0.20.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
